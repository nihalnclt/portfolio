{
  "manifest_version": 3,
  "name": "X Auto Follow",
  "version": "0.3.0",
  "description": "Follows the followers or following list of a given X account from your own logged-in session, at a random interval with a daily limit.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://nihaln.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "X Auto Follow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": ""
}
